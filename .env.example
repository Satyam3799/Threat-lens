# PostgreSQL (docker-compose defaults use service name "postgres")
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/threat_lens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=threat_lens
POSTGRES_SSLMODE=disable

# Redis / Celery (docker-compose defaults use service name "redis")
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated browser origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scanning & intel
SCAN_TIMEOUT_SECONDS=120
MAX_GLOBAL_ACTIVE_SCANS=4
MAX_USER_ACTIVE_SCANS=1
ALLOW_PRIVATE_SCAN_TARGETS=false
FULL_PORT_SCAN_ENABLED=false
ENABLE_INTEL_ENRICHMENT=false

# Optional intel API keys
SHODAN_API_KEY=
VT_API_KEY=
NVD_API_KEY=

# Frontend build (browser must reach the API host — use localhost when using published ports)
VITE_API_URL=http://localhost:8000

# Published host ports (optional; 6380/5433 avoid conflicts with local Redis/Postgres)
BACKEND_PORT=8000
FRONTEND_PORT=5173
REDIS_PORT=6380
POSTGRES_PORT=5433
