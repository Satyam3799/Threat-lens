# =============================================================================
# Threat Lens — environment template
# Copy to .env and adjust values before starting containers.
# =============================================================================

# --- Production (docker-compose.prod.yml) ------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# Public hostname (DuckDNS, Cloudflare, or your domain). Must resolve to the VPS.
DOMAIN=your-subdomain.duckdns.org
ACME_EMAIL=you@example.com

# Browser-facing API base URL (same origin as the UI; no trailing slash)
VITE_API_URL=https://your-subdomain.duckdns.org

# HTTPS origins only when APP_ENV=production
CORS_ORIGINS=https://your-subdomain.duckdns.org

# Generate with: openssl rand -hex 32  (minimum 32 characters in production)
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (internal to Docker network in production) ---------------------
POSTGRES_USER=threat_lens
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=threat_lens
DATABASE_URL=postgresql+psycopg2://threat_lens:replace-with-strong-postgres-password@postgres:5432/threat_lens
POSTGRES_SSLMODE=disable

# --- Redis / Celery (internal in production) ---------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Scanning & intel --------------------------------------------------------
SCAN_TIMEOUT_SECONDS=120
MAX_GLOBAL_ACTIVE_SCANS=4
MAX_USER_ACTIVE_SCANS=1
ALLOW_PRIVATE_SCAN_TARGETS=false
FULL_PORT_SCAN_ENABLED=false
ENABLE_INTEL_ENRICHMENT=true

# Optional intel API keys (enrichment degrades gracefully if unset)
SHODAN_API_KEY=
VT_API_KEY=
NVD_API_KEY=
INTEL_HTTP_TIMEOUT_SECONDS=12

# --- Local development (docker-compose.yml) ----------------------------------
# Published host ports (6380/5433 avoid conflicts with local Redis/Postgres)
BACKEND_PORT=8000
FRONTEND_PORT=5173
REDIS_PORT=6380
POSTGRES_PORT=5433

# Dev-only CORS and API URL (use when APP_ENV is not production)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VITE_API_URL=http://localhost:8000
